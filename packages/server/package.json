{
  "name": "@firebase-compat/server",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "firebase-compat": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node --experimental-strip-types src/cli.ts",
    "start": "node dist/cli.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@grpc/grpc-js": "^1.14.6",
    "@grpc/proto-loader": "^0.8.1",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "firebase": "^13.1.0",
    "firebase-admin": "^14.5.0",
    "vitest": "^5.0.5"
  },
  "files": [
    "dist",
    "protos",
    "README.md"
  ],
  "description": "Self-hostable backend compatible with the unmodified Firebase JS SDK (Auth, Firestore, Realtime Database, Storage)",
  "repository": {
    "type": "git",
    "url": "https://github.com/devtechedge/firebase-compat",
    "directory": "packages/server"
  },
  "engines": {
    "node": ">=22.13"
  }
}
